{
  "name": "@figma/my-make-file",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr app/entry-server.tsx && node scripts/prerender.mjs",
    "build:client": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist",
    "test": "vite build --ssr tests/pricing.test.ts --outDir .tmp-test --emptyOutDir --logLevel error && node .tmp-test/pricing.test.js && vite build --ssr tests/routing.test.ts --outDir .tmp-test --emptyOutDir --logLevel error && node .tmp-test/routing.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@radix-ui/react-select": "2.1.6",
    "clsx": "2.1.1",
    "griddy-icons": "^0.2.0",
    "lucide-react": "0.487.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "3.2.0",
    "tw-animate-css": "1.3.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@types/node": "20.19.43",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "gh-pages": "^6.3.0",
    "pixelmatch": "7.2.0",
    "playwright": "1.58.2",
    "pngjs": "7.0.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.1.12",
    "typescript": "5.9.3",
    "vite": "6.3.5"
  },
  "pnpm": {
    "overrides": {
      "vite": "6.3.5"
    }
  }
}
